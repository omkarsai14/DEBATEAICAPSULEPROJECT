# Pick ONE free provider. Provider is auto-detected from whichever key is set,
# or force it with LLM_PROVIDER=groq|gemini|openrouter|ollama|demo

# 1) Groq  (free, no credit card)  https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2) Google Gemini (free tier)  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3) OpenRouter (free ":free" models)  https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4) Ollama (runs locally on your PC, no key, no limits)  https://ollama.com
#    then run:  ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# Nothing set -> offline demo mode (rule-based scoring)
LLM_PROVIDER=
